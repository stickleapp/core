includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:

    paths:
        - src/
        - database/
        - resources/
        # Not shipped. Exercises the magic filter surface a consumer writes
        # against, so a wrong or missing method annotation on Filters\Base is
        # caught here rather than in someone else's build.
        - workbench/app/Filters/

    level: 8

    ignoreErrors:
        # StickleEntity is a trait for a consuming application's models, and its
        # only users in this repository live in workbench/, outside the analysed
        # paths -- so PHPStan reports it used zero times AND does not analyse it.
        #
        # Ignoring this keeps the trait unanalysed. That is a deliberate limit,
        # not an oversight: giving it an analysed user surfaces 12 further
        # errors inside the trait, which is past the scope this exclusion
        # removal was measured for. Analysing workbench/app wholesale is worse
        # again, at 51 unrelated errors.
        - '#Trait StickleApp\\Core\\Traits\\StickleEntity is used zero times#'
        - '#Call to an undefined method Illuminate\\Database\\Eloquent\\Builder<Illuminate\\Database\\Eloquent\\Model>::hasJoin\(\).#'
        - '#Method StickleApp\\Core\\Models\\ModelAttributes::attributable\(\) should return#'
        - '#Method StickleApp\\Core\\Models\\ModelAttributeAudit::attributable\(\) should return#'
        - '#Class StickleApp\\Core\\Models\\.* uses generic trait Illuminate\\Database\\Eloquent\\Factories\\HasFactory but does not specify its types: TFactory#'

    excludePaths:
        - src/Commands/InstallCommand.php
